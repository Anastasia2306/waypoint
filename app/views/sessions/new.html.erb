<div class="auth__mark">✱</div>
<h1 class="auth__title">Вход</h1>
<p class="auth__lead">Откройте свой трек: вехи, дедлайны и прогресс в одном месте.</p>

<%= form_with url: session_path, class: "auth-form" do |form| %>
  <div class="field">
    <%= form.label :email_address, "Email", class: "field__label" %>
    <%= form.email_field :email_address, required: true, autofocus: true,
          autocomplete: "username", placeholder: "name@university.edu",
          value: params[:email_address], class: "input" %>
  </div>

  <div class="field" data-controller="password">
    <%= form.label :password, "Пароль", class: "field__label" %>
    <div class="input-wrap">
      <%= form.password_field :password, required: true, autocomplete: "current-password",
            maxlength: 72, class: "input", data: { password_target: "input" } %>
      <button type="button" class="input-wrap__btn" data-action="password#toggle"
              data-password-target="button">Показать</button>
    </div>
  </div>

  <%= form.submit "Войти", class: "btn btn--dark btn--lg btn--block" %>
<% end %>

<p class="auth__switch"><%= link_to "Забыли пароль?", new_password_path %></p>
<p class="auth__switch">Нет аккаунта? <%= link_to "Зарегистрироваться", new_registration_path %></p>
