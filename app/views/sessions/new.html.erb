<h1>Вход в Waypoint</h1>

<form action="/session" method="post">
  <div>
    <label for="email_address">Email:</label><br>
    <input type="email" name="email_address" id="email_address" required autofocus placeholder="Enter your email address" value="<%= params[:email_address] %>">
  </div>

  <div>
    <label for="password">Пароль:</label><br>
    <input type="password" name="password" id="password" required placeholder="Enter your password">
  </div>

  <div>
    <input type="submit" value="Sign in">
  </div>
</form>

<p>
  <a href="/passwords/new">Forgot password?</a>
</p>

<p>
  Нет аккаунта? <a href="/registration/new">Зарегистрироваться</a>
</p>