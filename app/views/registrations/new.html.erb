<h1>Регистрация в Waypoint</h1>

<form action="/registration" method="post">
  <div>
    <label for="email_address">Email:</label><br>
    <input type="email" name="user[email_address]" id="email_address" required autofocus>
  </div>

  <div>
    <label for="password">Пароль:</label><br>
    <input type="password" name="user[password]" id="password" required>
  </div>

  <div>
    <label for="password_confirmation">Подтвердите пароль:</label><br>
    <input type="password" name="user[password_confirmation]" id="password_confirmation" required>
  </div>

  <div>
    <input type="submit" value="Зарегистрироваться">
  </div>
</form>

<p>
  Уже есть аккаунт? <a href="/session/new">Войти</a>
</p>
