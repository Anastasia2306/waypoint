<% project_notes = @project.progress_notes.select { |note| note.milestone_id.nil? }.sort_by(&:created_at).reverse %>

<%# Подписка на живые обновления этой работы (Action Cable + Turbo Streams) %>
<%= turbo_stream_from @project %>

<div class="project-live" <%= "data-participant" if participant?(@project) %>>
  <%= link_to "← К обзору", root_path, class: "back-link" %>

  <section class="hero2 hero2--compact hero-gradient">
    <div>
      <p class="eyebrow"><%= project_kind_label(@project.kind) %></p>
      <h1 class="hero2__title"><%= @project.title %></h1>
      <p class="hero2__text">
        Студент: <strong><%= @project.student.display_name %></strong>
        <% if @project.student.study_info.present? %>(<%= @project.student.study_info %>)<% end %> ·
        Научник: <strong><%= @project.supervisor.display_name %></strong>
      </p>
      <%= render "research_projects/summary", project: @project %>
    </div>
  </section>

  <section class="card" id="about">
    <h2 class="card__title">О работе</h2>
    <%= render "research_projects/about", project: @project %>
    <% if project_student?(@project) %>
      <%= render "research_projects/repository_form", project: @project %>
    <% end %>
  </section>

  <div class="layout">
    <section class="card">
      <h2 class="card__title">Вехи</h2>

      <% if @project.milestones.empty? %>
        <p id="milestones_empty" class="muted">
          <%= project_student?(@project) ? "Вех пока нет. Добавьте первую ниже." : "Студент ещё не добавил вехи." %>
        </p>
      <% end %>

      <div id="milestones">
        <% @project.milestones.each do |milestone| %>
          <%= render "milestones/milestone", milestone: milestone, project: @project %>
        <% end %>
      </div>

      <% if project_student?(@project) %>
        <%= render "milestones/form", project: @project, milestone: Milestone.new %>
      <% end %>
    </section>

    <aside class="card" id="notes">
      <h2 class="card__title">Комментарии к работе</h2>

      <% if participant?(@project) %>
        <%= render "progress_notes/form", project: @project, milestone: nil, note: ProgressNote.new %>
      <% end %>

      <div id="project_notes" class="comments-list" style="margin-top: var(--space-3)">
        <% project_notes.each do |note| %>
          <%= render "research_projects/note", note: note, project: @project %>
        <% end %>
      </div>
    </aside>
  </div>
</div>
